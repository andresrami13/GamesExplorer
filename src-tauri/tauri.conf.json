{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mis juegos",
  "mainBinaryName": "mis-juegos",
  "identifier": "com.misjuegos.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mis juegos",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#0e0b14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: img: http://img.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
